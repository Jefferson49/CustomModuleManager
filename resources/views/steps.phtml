<?php

declare(strict_types=1);

namespace Jefferson49\Webtrees\Module\CustomModuleManager;

use Fisharebest\Webtrees\View;
use Jefferson49\Webtrees\Internationalization\MoreI18N;


/**
 * @var array<string,string> $steps
 * @var string               $title
 */

?>

<?php if ($title !== '') : ?>
    <h3>
        <?= $title ?>
    </h3>
<?php endif ?>

<p>
    <?= MoreI18N::xlate('It can take several minutes to download and install the upgrade. Be patient.') ?>
</p>

<dl>
    <?php foreach ($steps as $url => $text) : ?>
    <dt><?= $text ?></dt>
    <dd data-url="<?= e($url) ?>"></dd>
    <?php endforeach ?>
</dl>

<?php View::push('javascript') ?>
<script>
  function nextAjaxStep() {
    const el = document.querySelector('dd:empty');

    if (!el) {
      return;
    }

    el.innerHTML = <?= json_encode(view('icons/spinner')) ?>;

    fetch(el.dataset.url, {
      headers: {
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
      .then(response => response.text())
      .then(html => {
        el.innerHTML = html;
        nextAjaxStep();
      })
      .catch(() => {
        el.innerHTML = '';
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', nextAjaxStep);
  } else {
    nextAjaxStep();
  }
</script>
<?php View::endpush() ?>
